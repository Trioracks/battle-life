  "formatPolicy": {
    "status": "author_requested_layer_numeric_cap_proposed",
    "sequence": [
      "personal_quality",
      "format_penalty",
      "final_raw_score",
      "display_grade_or_pair_vote"
    ],
    "adherenceRange": [
      0,
      1
    ],
    "maxPenaltyProposed": 1.5,
    "gradeScale": 10,
    "mismatchRange": [
      0,
      1
    ],
    "formula": "penalty=adherence*maxPenalty*mismatch; finalRaw=personalQuality-penalty",
    "axes": [
      "diss_addressing",
      "text_approach",
      "genre_profile",
      "sound_aesthetic"
    ],
    "numericAdherenceDefaults": null,
    "hiddenProfileKnownByJudge": true,
    "playerKnowledgeSeparate": true,
    "prohibitDoubleCountingSameMismatch": true,
    "examples": [
      {
        "adherence": 0,
        "penalty": 0,
        "finalRaw": 7.2
      },
      {
        "adherence": 0.3,
        "penalty": 0.36,
        "finalRaw": 6.84
      },
      {
        "adherence": 1,
        "penalty": 1.2,
        "finalRaw": 6
      }
    ]
  },
  "marginPolicy": {
    "units": "4*finalRawScore_difference_before_clamp_rounding_and_grade_strictness",
    "closeMaxProposed": 2,
    "clearWinMinProposed": 10,
    "crushingLossMinProposed": 20,
    "tieRule": null
  },
  "noveltyPolicy": {
    "historyPerJudge": true,
    "avoidExactNonMicroRepeat": true,
    "templateRecentWindowProposed": 12,
    "maxSameFamilyConsecutiveProposed": 2,
    "requirementsNeverBypassed": true,
    "externalRuntimeModelAssumed": false,
    "requires50TrackSimulationBeforeGameIntegration": true
  },
  "checksToRun": {
    "rowsPerJudge": 81,
    "rhymePositivePerJudge": 10,
    "rhymeNegativePerJudge": 10,
    "unresolvedRenderedSlotsAllowed": false
  },
  "notes": [
    "These are newly authored examples, not historical quotes or installed game behavior.",
    "Detailed causes and reference knowledge require saved simulated facts; no new player typing workflow is required.",
    "High slider is not high quality; genre and skill influence the realized outcome.",
    "Format concern templates are conditional alternatives; never randomize adherence just to use a phrase."
  ]
