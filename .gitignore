# Dependencies and generated checks stay out of source history.
node_modules/
coverage/
dist/
artifacts/
__pycache__/
*.py[cod]
*.log

# Local editor backups and optional worktrees.
*.blend[1-9]
.worktrees/

# Local credentials; examples may be tracked.
.env
.env.*
!.env.example
!.env.sample

# Goblin's supplied recordings are local-only, like the full sound packs.
/assets/audio/goblin/
/assets/audio/filya/
